# Dependencies
node_modules/

# Build output
apps/desktop/dist/
apps/desktop/build/
# Packaged app: published on GitHub Releases, never committed.
apps/desktop/artifacts/

# The iCloud sync helper's Xcode build, and Xcode's per-user state.
apps/desktop/sync-helper/build/
xcuserdata/

# The iOS app: Xcode and SwiftPM build output, the built slide page (`bun run ios:stage`)
# and the exported built-in book (`bun run ios:sample`), which is a generated book like any other.
apps/ios/build/
apps/ios/CairnKit/.build/
apps/ios/Cairn/Resources/Stage/
apps/ios/Cairn/Resources/SampleBook/

# Electrobun toolchain: `electrobun prepare` projects the SDK here, and the
# packager leaves scratch dirs behind. Both are regenerated by `bun run start`.
apps/desktop/.hutch/
**/.cottontail-tmp/

# Pipeline cache: per-book map/decks/audio, resumable across runs. Regenerating
# it costs model time, not correctness — it does not belong in history.
.cache/

# Generated books. This is derived content from books the owner already has:
# full chapter text and narration audio. It stays on the machine that made it.
apps/desktop/public/books/
apps/desktop/public/books.json

# Secrets. TAVILY_API_KEY lives in the environment, never in a file here.
.env
.env.*

# Icon previews. scripts/make-iconset.py regenerates them from icon.src.png;
# only icon.iconset/ is a build input, and that one is tracked.
apps/desktop/icon.png
apps/desktop/icon.icns

# Agent working files: plans, research notes, superpowers run state, per-machine Claude settings.
.superpowers/
docs/superpowers/
docs/plans/
docs/research/
.claude/settings.local.json

# Third-party agent skills (Matt Pocock's), installed per machine; skills-lock.json records them.
# Only skills written for this project are tracked.
.agents/skills/*
!.agents/skills/cairn-desktop-verify/
.claude/skills/*
!.claude/skills/cairn-desktop-verify

# macOS
.DS_Store

# Logs
*.log

# Local issue tracker: specs and issues stay on this machine.
.scratch/
