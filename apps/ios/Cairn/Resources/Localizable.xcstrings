    "shelf.remove.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is deleted from iCloud and from this iPhone, freeing %@. It stays on your Mac, and is not synced again unless you turn it back on there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从 iCloud 和这台 iPhone 上删除，释放 %@。Mac 上的书不受影响；除非你在 Mac 上重新打开，它不会再同步过来。"
          }
        }
      }
    },
