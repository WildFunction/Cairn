    "settings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this iPhone for listening offline. Touch and hold a book on the shelf to remove it from iCloud. The built-in book is part of the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在这台 iPhone 上，离线也能听。在书架上长按一本书，可以把它从 iCloud 移除。内置的书是 App 的一部分。"
          }
        }
      }
    },
