    "shelf.remove.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud could not be reached. Nothing was changed; try again when you are online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上 iCloud，什么都没有改动。联网后再试一次。"
